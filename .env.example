# Copy this file to <DEPLOY_PATH>/.env on the test server. Never commit the real file.
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-a-long-random-jwt-secret

# Comma-separated browser origins allowed to call the API. Leave empty when the
# application is accessed only through the bundled Nginx site at the same origin.
CORS_ALLOWED_ORIGINS=
