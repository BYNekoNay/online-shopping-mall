<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pzhu.mall.modules.product.mapper.ReviewMapper">

    <select id="listByProductId" resultType="com.pzhu.mall.modules.product.entity.Review">
        SELECT * FROM review
        WHERE product_id = #{productId}
        ORDER BY create_time DESC
    </select>

    <select id="avgRatingByProductId" resultType="java.lang.Double">
        SELECT AVG(rating) FROM review
        WHERE product_id = #{productId}
    </select>

    <select id="countByProductId" resultType="java.lang.Long">
        SELECT COUNT(*) FROM review
        WHERE product_id = #{productId}
    </select>

    <!-- FRONT-QA-02 修复：批量查询多商品平均评分（列表页/推荐页填充真实评分，避免 N+1） -->
    <select id="selectAvgRatingByProductIds" resultType="java.util.Map">
        SELECT product_id AS productId, AVG(rating) AS avgRating
        FROM review
        WHERE product_id IN
        <foreach collection="productIds" item="pid" open="(" separator="," close=")">
            #{pid}
        </foreach>
        GROUP BY product_id
    </select>

</mapper>
