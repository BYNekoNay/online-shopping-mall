<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
  <!-- 排除测试代码（单测中的 mock 技巧常见误报） -->
  <Match>
    <Source name="~.*Test\.java" />
  </Match>
  <!-- 排除实体类 getter/setter 集合浅拷贝告警（项目实体为纯 POJO，不对外暴露可变状态） -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2" />
    <Class name="~com\.pzhu\.mall\.modules\..*\.entity\..*" />
  </Match>
  <!-- 排除 DTO/VO/Controller 内部类的集合浅拷贝告警（REST 序列化常规模式，防御性拷贝收益低） -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2" />
    <Class name="~com\.pzhu\.mall\.modules\..*\.(dto|vo)\..*" />
  </Match>
  <Match>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2" />
    <Class name="~com\.pzhu\.mall\.modules\..*\..*Controller\$.*" />
  </Match>
  <!-- 排除 common.result.PageResult（通用分页结构）与定时任务 keys 集合（Redis 键列表，读取型安全） -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2" />
    <Class name="~com\.pzhu\.mall\.common\.result\..*" />
  </Match>
  <Match>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2" />
    <Class name="~com\.pzhu\.mall\.modules\..*\.task\..*" />
  </Match>
  <!-- 排除 UserService 中 AddressService 依赖注入的 EI 误报（Spring 单例注入场景） -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2" />
    <Class name="~com\.pzhu\.mall\.modules\.user\.service\.UserService" />
  </Match>
  <!-- 排除 DTO 类的 setter 未使用告警（序列化框架使用） -->
  <Match>
    <Bug pattern="UWF_UNWRITTEN_PUBLIC_OR_PROTECTED_FIELD,URF_UNREAD_PUBLIC_OR_PROTECTED_FIELD" />
    <Class name="~com\.pzhu\.mall\.modules\..*\.dto\..*" />
  </Match>
  <!-- 排除 lambda 中的瞬态通知类问题（项目无 GUI） -->
  <Match>
    <Bug pattern="DM_CONVERT_CASE" />
  </Match>

  <!-- ============ SB-02~05 豁免（2026-08-14 检查方案执行，均已防御，静态误报） ============ -->
  <!-- SB-02：StockService.deductWithLock —— Redis execute()/hasKey() 返回已做 null 防御（remaining==null 即失败），
       SpotBugs 无法识别 Spring Data Redis 的 @Nullable 语义，属已知误报 -->
  <Match>
    <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE" />
    <Class name="~com\.pzhu\.mall\.modules\.order\.component\.StockService" />
    <Method name="deductWithLock" />
  </Match>
  <!-- SB-03：RecommendCalculateService.computeHotRank —— 销量归一化已显式 intValue() 拆箱，
       三元运算结果在取 max 前已收敛为 double，无装箱强转风险 -->
  <Match>
    <Bug pattern="BX_UNBOXED_AND_COERCED_FOR_TERNARY_OPERATOR" />
    <Class name="~com\.pzhu\.mall\.modules\.recommend\.service\.RecommendCalculateService" />
  </Match>
  <!-- SB-04/SB-05：RecommendService.readFromRedis / readSimilarFromRedis —— TypedTuple.getScore() 已
       用三元（!=null ? : 0.0）防御；value 解析已 catch NumberFormatException，空列表有 isEmpty 兜底 -->
  <Match>
    <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE" />
    <Class name="~com\.pzhu\.mall\.modules\.recommend\.service\.RecommendService" />
    <Method name="~read(FromRedis|SimilarFromRedis)" />
  </Match>
</FindBugsFilter>
