# Dependencies
node_modules/

# Build output
dist/
build/
backend/target/

# Environment
.env.local
.env.*.local

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Redis
*.rdb
*.aof
dump.rdb

# Maven
backend/target/
backend/target_*/
backend/.build-bak/

# 前端构建产物（含验证目录）
frontend/dist/
frontend/dist-*/
frontend/vite.config.js.timestamp-*.mjs
# vite-plugin-mock 打包临时产物（bundle-require 生成，正常会自动清理）
frontend/src/mock/_*.bundled_*.mjs

# Temp files
# H-11 修复：忽略根目录下所有 _* 前缀的调试残留文件（含密码哈希、管理员 JWT、
# 硬编码凭据的启动脚本等），防止再次入库
/_*
_tmp_*
*.err

# IDE state
.omc/

# WorkBuddy 工作区数据（记忆/会话文件，不入库）
.workbuddy/

# 前端本地缓存与工具临时文件
frontend/.npm-cache-local/
frontend/npm-cache-local2/
frontend/vitest.config.js.timestamp-*.mjs

# Runtime
query
user-check.txt
backend/user-check.txt
